{
  "pipegen_version": "0.5.1",
  "pipeline_id": "pipegen-sentinel-track-a-01",
  "name": "Workplace Safety Sentinel Pipeline IR",
  "graph": {
    "nodes": [
      {
        "id": "node_source",
        "plugin": "filesrc",
        "category": "Input",
        "properties": {
          "location": "test_assets/safety_video.mp4"
        },
        "outputs": ["stream_raw"]
      },
      {
        "id": "node_parser_decoder",
        "plugin": "qtdemux_h264parse_nvv4l2decoder",
        "category": "Decoder",
        "properties": {
          "enable_hw_accel": true,
          "cuda_device_id": 0
        },
        "inputs": ["stream_raw"],
        "outputs": ["video_nvmm"]
      },
      {
        "id": "node_streammux",
        "plugin": "nvstreammux",
        "category": "Muxer",
        "properties": {
          "batch_size": 1,
          "width": 1920,
          "height": 1080,
          "batched_push_timeout": 33333,
          "live_source": false
        },
        "inputs": ["video_nvmm"],
        "outputs": ["muxed_batch"]
      },
      {
        "id": "node_nvinfer_tensorrt",
        "plugin": "nvinfer",
        "category": "Inference",
        "properties": {
          "config_file": "model_config.json",
          "model_engine_file": "model_b1_gpu0_fp16.engine",
          "batch_size": 1,
          "network_mode": "FP16",
          "gpu_id": 0,
          "interval": 0
        },
        "inputs": ["muxed_batch"],
        "outputs": ["inference_meta"]
      },
      {
        "id": "node_nvtracker",
        "plugin": "nvtracker",
        "category": "Tracker",
        "properties": {
          "ll_lib_file": "libnvds_nvmultiobjecttracker.so",
          "ll_config_file": "config_tracker_NvSORT.yml",
          "tracker_width": 640,
          "tracker_height": 384,
          "enable_batch_process": 1
        },
        "inputs": ["inference_meta"],
        "outputs": ["tracked_meta"]
      },
      {
        "id": "node_safety_sentinel_probe",
        "plugin": "safety_events.engine",
        "category": "Analytics",
        "properties": {
          "probe_point": "src_pad",
          "zone_config": "safety_events/zones.json",
          "output_jsonl": "demo/sample_events.jsonl",
          "event_schema": "1.0"
        },
        "inputs": ["tracked_meta"],
        "outputs": ["safety_meta"]
      },
      {
        "id": "node_osd_sink",
        "plugin": "nvdsosd_nvoverlaysink",
        "category": "Sink",
        "properties": {
          "display_text": 1,
          "display_bbox": 1,
          "sync": 1
        },
        "inputs": ["safety_meta"],
        "outputs": []
      }
    ]
  }
}
